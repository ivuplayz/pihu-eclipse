# Pihu-BreakThough — FREE-ONLY configuration
# Copy to .env locally. Never commit real keys.

PIHU_FREE_ONLY=true

# Database (Neon PostgreSQL)
DATABASE_URL=

# AI pool
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

HF_API_KEY=
HF_MODEL=

# Optional local fallback. Pihu works when this is offline.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Future capability pools will use separate provider variables.
# IMAGE_PROVIDER_1_API_KEY=
# STT_PROVIDER_1_API_KEY=
# TTS_PROVIDER_1_API_KEY=
# SEARCH_PROVIDER_1_API_KEY=
